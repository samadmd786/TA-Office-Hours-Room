# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Mattermost that Switch Console started for you. In Switch Console open the
# server's Home page, find Mattermost under "Messaging apps", and use
# "Sign-in details..." for the URL and admin account.
MM_URL=http://localhost:8065
MM_ADMIN_USER=
MM_ADMIN_PASSWORD=

# The team's URL slug (the part after the host in a Mattermost link).
MM_TEAM=

# The office-hours channel Switch created from the template. Its name or its
# display name both work.
MM_CHANNEL=cld101-office-hours

# One test password for all fake students. Make up a long one; it only
# exists in your local Mattermost. Mattermost's default policy wants 8+
# characters.
STUDENT_PASSWORD=
